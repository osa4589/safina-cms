{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "safina-cms",
  // No `account_id` here on purpose: this repository is public. Supply the
  // account at deploy time via the CLOUDFLARE_ACCOUNT_ID environment variable.
  "compatibility_date": "2026-07-19",
  // `nodejs_compat` is load-bearing: postgres, nodemailer and
  // lib/collaborator-invite.ts (randomBytes from "crypto") need Node APIs.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding; the service name must match the worker name.
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "safina-cms"
    }
  ],
  // Pools Postgres connections so each Worker isolate does not open its own.
  // Origin is the DIRECT Supabase endpoint (5432): both Supavisor modes break
  // search_path — transaction mode rejects it outright, session mode silently
  // ignores it — and Drizzle emits unqualified table names.
  // db/index.ts falls back to DATABASE_URL when this binding is absent, so
  // removing this block reverts to a known-good direct-connection setup.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dfa795cdbe7b4f41a645c7b492525b3d"
    }
  ]
}
