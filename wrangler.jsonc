{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "safina-cms",
  // No `account_id` here on purpose: this repository is public. Supply the
  // account at deploy time via the CLOUDFLARE_ACCOUNT_ID environment variable.
  "compatibility_date": "2026-07-19",
  // `nodejs_compat` is load-bearing: postgres, nodemailer and
  // lib/collaborator-invite.ts (randomBytes from "crypto") need Node APIs.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding; the service name must match the worker name.
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "safina-cms"
    }
  ]
  // No `hyperdrive` binding: the deploy token lacks Hyperdrive:Edit, so the
  // config could not be created. Instead DATABASE_URL is a Worker secret
  // pointing at Supabase's Supavisor pooler (port 6543), which provides the
  // server-side connection pooling Hyperdrive would have. db/index.ts already
  // prefers a HYPERDRIVE binding when present, so adding one later is purely
  // additive — grant the token Hyperdrive:Edit, run
  //   npx wrangler hyperdrive create safina-cms-db --connection-string="<pooler-url>"
  // and re-add the binding block here. `prepare: false` is already set in
  // db/index.ts, which transaction-mode pooling requires either way.
}
